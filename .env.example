# PostgreSQL only. For local development run npm run db:dev and use the URL it prints.
DATABASE_URL="postgresql://docs:replace-me@127.0.0.1:5432/new_api_docs?schema=public"

# Exact browser origin (scheme + host + port). Remote access must use its public IP/domain here.
# HTTPS is required for production session cookies. Never disable Origin checks for remote access.
APP_URL="http://localhost:3210"

# Production startup creates the first admin automatically; existing accounts/passwords are preserved.
# Local development can use npm run db:bootstrap or npm run db:seed.
# Set a real address and a unique password of at least 12 characters locally. Do not commit them.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
