    "@types/react-dom": "^19.0.0",
    "dotenv": "^17.0.0",
    "embedded-postgres": "18.4.0-beta.17",
    "esbuild": "0.28.2",
    "pg": "^8.16.0",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
