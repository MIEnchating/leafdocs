{
  "name": "leafdocs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3210",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0 --port 3210",
    "start:production": "sh scripts/start-production.sh",
    "typecheck": "tsc --noEmit",
