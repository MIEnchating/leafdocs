# 修改后再手动拉取镜像和启动。不要提交真实的 .env。
# 站点域名，不含 https:// 或路径；请在 Nginx 配置此域名的 HTTPS。
DOMAIN=

# 新部署：设置随机的长密码，建议仅使用字母和数字（该值也用于数据库 URL）。
# 已有数据库：必须保留原密码，修改此项不会修改数据库中的密码。
POSTGRES_PASSWORD=

# 仅在数据库没有任何用户时创建管理员；已有账号不会因修改这里而重置。
ADMIN_EMAIL=
# 12 至 1024 字节；用单引号包裹以保留 $、# 等字符。
# 密码中若含单引号，请使用 \' 转义该单引号。
ADMIN_PASSWORD=''

# Nginx 容器实际连接的已有 Docker 网络；不会自动创建。
PROXY_NETWORK=newapi_default
LEAFDOCS_IMAGE=mienvirtuoso/leafdocs:latest
