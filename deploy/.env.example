# DNS hostname only, without https:// or a path. Point its A/AAAA records at this server.
DOMAIN=docs.example.com

# Optional: pin a release or a commit tag instead of latest.
LEAFDOCS_IMAGE=mienvirtuoso/leafdocs:latest

# Generate with: openssl rand -hex 32
# Use letters and digits only because this value is also used in DATABASE_URL.
POSTGRES_PASSWORD=

# Your administrator login email. There is no built-in/default administrator account.
# After starting the containers, create it with: docker compose exec app npm run db:seed
ADMIN_EMAIL=admin@example.com
# Generate with: openssl rand -hex 24
# At least 12 bytes; use single quotes if a custom password contains $ or #.
ADMIN_PASSWORD=
